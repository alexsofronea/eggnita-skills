#!/usr/bin/env bash
#
# eggnita-skills pre-commit hook — blocks commits that look like they contain secrets.
#
# Enable once per clone (also documented in CONTRIBUTING.md):
#   git config core.hooksPath .githooks
#
# This is a safety net, not a guarantee. Review your own diffs. If you must commit
# something this flags as a false positive, run: git commit --no-verify
#
set -euo pipefail

# Only scan what's staged, added/changed lines only.
staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged" ] && exit 0

# Patterns for common secret shapes. Kept deliberately broad; tune as needed.
patterns=(
  'AKIA[0-9A-Z]{16}'                                  # AWS access key id
  'ASIA[0-9A-Z]{16}'                                  # AWS temporary key id
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'                # private keys
  'gh[pousr]_[0-9A-Za-z]{30,}'                         # GitHub tokens
  'xox[baprs]-[0-9A-Za-z-]{10,}'                       # Slack tokens
  'sk-[A-Za-z0-9]{20,}'                                # OpenAI-style secret keys
  'sk-ant-[A-Za-z0-9_-]{20,}'                          # Anthropic keys
  'AIza[0-9A-Za-z_-]{35}'                              # Google API key
  'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.'        # JWTs
  '(secret|token|password|passwd|api[_-]?key)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/+_-]{16,}'
)

found=0
while IFS= read -r file; do
  [ -f "$file" ] || continue
  # Skip this hook and the example env file.
  case "$file" in
    .githooks/pre-commit|*.env.example) continue ;;
  esac
  added="$(git diff --cached -U0 -- "$file" | grep '^+' | grep -v '^+++' || true)"
  [ -z "$added" ] && continue
  for pat in "${patterns[@]}"; do
    if printf '%s\n' "$added" | grep -Eq -e "$pat"; then
      echo "  ✗ possible secret in: $file  (pattern: ${pat:0:32}...)"
      found=1
    fi
  done
done <<< "$staged"

if [ "$found" -ne 0 ]; then
  echo ""
  echo "Commit blocked: the staged changes look like they contain a secret."
  echo "Remove it, or if it is a genuine false positive: git commit --no-verify"
  exit 1
fi

exit 0
